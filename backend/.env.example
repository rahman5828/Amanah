APP_NAME=AMANAH
APP_ENV=development

# PostgreSQL connection string (development)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/amanah_db

# JWT — generate a long random secret for local use, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit real secrets. Rotate JWT_SECRET_KEY to invalidate all existing tokens.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
